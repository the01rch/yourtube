#!/bin/sh
# yt-clip: read a YouTube URL from the clipboard, play or download it
# Usage: yt-clip [play|download]
#
# Handles:
#   - Single videos (watch, shorts, embed, youtu.be)
#   - Playlists (watch?v=...&list=..., /playlist?list=...)
#   - YouTube Mix/Radio playlists (RD...) by converting them to watch URLs
#   - Codec preference: VP9 > H.264 > AV1 > anything else
#   - Hardware decode on AMD Radeon 780M (VCN 4.0) via VA-API

set -e

MODE="${1:-play}"
DOWNLOADER="yt-dlp"
DOWNLOAD_DIR="$HOME/Downloads"

# --- Format selection ---
# Codec order (lowest power first on AMD Radeon 780M / VCN 4.0):
#   1. VP9   (vp9 / vp09)  — lowest draw
#   2. H.264 (avc1)        — essentially tied with VP9
#   3. AV1   (av01)        — hardware-decoded, ~2W higher
FORMAT_SPEC="bestvideo[height<=1080][vcodec^=vp9]+bestaudio/bestvideo[height<=1080][vcodec^=avc1]+bestaudio/bestvideo[height<=1080][vcodec^=av01]+bestaudio/bestvideo[height<=1080]+bestaudio/best[height<=1080]"

# --- mpv flags for AMD Radeon 780M (RDNA 3, VCN 4.0) ---
MPV_FLAGS="
  --hwdec=vaapi
  --vo=gpu
  --gpu-api=vulkan
  --profile=fast
  --ytdl-format=$FORMAT_SPEC
  --ytdl-raw-options=yes-playlist=
  --prefetch-playlist=no
  --cache=yes
  --demuxer-max-bytes=150MiB
  --demuxer-max-back-bytes=75MiB
  --force-window=yes
  --really-quiet
"

# Read clipboard
URL=$(xclip -o -selection clipboard 2>/dev/null || true)

if [ -z "$URL" ]; then
    notify-send "yt-clip" "Clipboard is empty" 2>/dev/null || echo "Clipboard is empty"
    exit 1
fi

# --- Handle YouTube Mix/Radio playlists (RD...) ---
# These are generated by YouTube and often return "unviewable" errors.
# The workaround is to use the watch URL format with the video ID
# extracted from the RD list ID.
if printf '%s' "$URL" | grep -q 'list=RD'; then
    # Extract the video ID that follows "RD" in the list parameter
    MIX_VIDEO_ID=$(printf '%s' "$URL" | sed -n 's/.*list=RD\([^&]*\).*/\1/p')
    if [ -n "$MIX_VIDEO_ID" ]; then
        # Construct a watch URL that yt-dlp can process as a playlist
        YT_URL="https://www.youtube.com/watch?v=${MIX_VIDEO_ID}&list=RD${MIX_VIDEO_ID}"
        VIDEO_ID="(mix: ${MIX_VIDEO_ID})"
    else
        # Fallback: use the URL as-is, though it may fail
        YT_URL="$URL"
        VIDEO_ID="(mix)"
    fi
# --- Handle standard playlists and videos ---
elif printf '%s' "$URL" | grep -q 'list='; then
    # URL already contains a playlist reference — keep it intact.
    YT_URL="$URL"
    VIDEO_ID="(playlist)"
else
    VIDEO_ID=""
    case "$URL" in
        *youtube.com/watch*)
            VIDEO_ID=$(printf '%s' "$URL" | sed -n 's/.*[?&]v=\([^&]*\).*/\1/p') ;;
        *youtube.com/embed/*)
            VIDEO_ID=$(printf '%s' "$URL" | sed -n 's|.*/embed/\([^?&]*\).*|\1|p') ;;
        *youtube.com/shorts/*)
            VIDEO_ID=$(printf '%s' "$URL" | sed -n 's|.*/shorts/\([^?&]*\).*|\1|p') ;;
        *youtu.be/*)
            VIDEO_ID=$(printf '%s' "$URL" | sed -n 's|.*youtu.be/\([^?&]*\).*|\1|p') ;;
        */watch*)
            VIDEO_ID=$(printf '%s' "$URL" | sed -n 's/.*[?&]v=\([^&]*\).*/\1/p') ;;
        *)
            notify-send "yt-clip" "Not a YouTube URL" 2>/dev/null || echo "Not a YouTube URL"
            exit 1 ;;
    esac

    if [ -z "$VIDEO_ID" ]; then
        notify-send "yt-clip" "Could not extract video ID" 2>/dev/null || echo "Could not extract video ID"
        exit 1
    fi

    YT_URL="https://www.youtube.com/watch?v=$VIDEO_ID"
fi

if [ "$MODE" = "download" ]; then
    notify-send "yt-clip" "Downloading $VIDEO_ID" 2>/dev/null || echo "Downloading $VIDEO_ID"
    exec "$DOWNLOADER" \
        -f "$FORMAT_SPEC" \
        --yes-playlist \
        -o "$DOWNLOAD_DIR/%(playlist_title)s/%(playlist_index)s - %(title)s.%(ext)s" \
        "$YT_URL"
else
    notify-send "yt-clip" "Playing $VIDEO_ID" 2>/dev/null || echo "Playing $VIDEO_ID"
    exec mpv $MPV_FLAGS "$YT_URL"
fi
